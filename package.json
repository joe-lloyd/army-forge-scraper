{
  "name": "army-forge-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=web",
    "lint": "turbo run lint",
    "scraper": "turbo run start --filter=@opr-api/scraper",
    "capture": "turbo run capture --filter=@opr-api/scraper",
    "normalize": "turbo run normalize --filter=@opr-api/scraper",
    "test": "turbo run test",
    "update-data": "turbo run update-data --filter=web"
  },
  "devDependencies": {
    "turbo": "latest"
  },
  "packageManager": "pnpm@10.12.4"
}
